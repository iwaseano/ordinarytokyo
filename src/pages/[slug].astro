---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import type { ImageMetadata } from 'astro';
import AdSlot from '../components/AdSlot.astro';
import ArticleList from '../components/ArticleList.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getAffiliateLink } from '../data/affiliate';
import { getArticlePath, getSayPhraseId, getSortedArticles } from '../data/articles';
import { SITE, STAGES, domainInfo } from '../data/site';
import { formatDate, formatJpy, formatUsd } from '../utils/format';

const heroImages = import.meta.glob<{ default: ImageMetadata }>(
	'/src/assets/articles/**/images/*.{svg,png,jpg,jpeg,webp,avif}',
	{ eager: true },
);
const defaultHeroImage = '/og-default.svg';
const defaultHeroAlt = `${SITE.name} logo and tagline.`;

export async function getStaticPaths() {
	const articles = await getCollection('articles', ({ data }) =>
		import.meta.env.DEV ||
		import.meta.env.PUBLIC_SHOW_DRAFTS === 'true' ||
		!data.draft,
	);
	return articles.map((article) => ({
		params: { slug: article.data.slug },
		props: { article },
	}));
}

const { article } = Astro.props;
const { Content } = await render(article);
const data = article.data;
if (!article.body?.trim()) {
	throw new Error(`Article "${data.slug}" must include Markdown body content.`);
}
const readingMinutes = Math.max(
	1,
	Math.ceil(article.body.trim().split(/\s+/).length / 220),
);
const relativeImage = data.heroImage?.replace(/^\.\//, '');
const heroImagePath = relativeImage
	? `/src/assets/articles/${data.slug}/${relativeImage}`
	: undefined;
const heroImageModule = heroImagePath ? heroImages[heroImagePath] : undefined;
const heroImageFormat = data.heroImage?.toLowerCase().endsWith('.svg') ? 'svg' : 'webp';

if (heroImagePath && !heroImageModule) {
	console.warn(
		`Hero image not found for "${data.slug}": expected ${heroImagePath}. Using ${defaultHeroImage}.`,
	);
}

const articles = await getSortedArticles();
const related = articles
	.filter((candidate) => {
		if (candidate.data.slug === data.slug) return false;
		return (
			candidate.data.stage === data.stage ||
			candidate.data.domain === data.domain ||
			candidate.data.chain.some((chain) => data.chain.includes(chain))
		);
	})
	.slice(0, 4);
const affiliateItems = data.affiliateLinks.map((id) => getAffiliateLink(id));
const domain = domainInfo(data.domain);
const stage = STAGES[data.stage];
const cardImageUrl = `/cards/${data.slug}/1.svg`;
const canonicalPath = getArticlePath(data.slug);
const structuredData = JSON.stringify([
	{
		'@context': 'https://schema.org',
		'@type': 'Article',
		headline: data.title,
		description: data.description,
		datePublished: data.publishedAt.toISOString(),
		dateModified: data.updatedAt.toISOString(),
		author: { '@type': 'Person', name: SITE.author },
		mainEntityOfPage: new URL(canonicalPath, SITE.url).toString(),
		image: new URL(cardImageUrl, SITE.url).toString(),
		publisher: { '@type': 'Organization', name: SITE.name },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
			{
				'@type': 'ListItem',
				position: 2,
				name: data.title,
				item: new URL(canonicalPath, SITE.url).toString(),
			},
		],
	},
	...(data.faq.length
		? [
				{
					'@context': 'https://schema.org',
					'@type': 'FAQPage',
					mainEntity: data.faq.map((item) => ({
						'@type': 'Question',
						name: item.question,
						acceptedAnswer: {
							'@type': 'Answer',
							text: item.answer,
						},
					})),
				},
			]
		: []),
])
	.replace(/</g, '\\u003c');
---

<SiteLayout
	title={`${data.title} | ${SITE.name}`}
	description={data.description}
	canonicalPath={canonicalPath}
	ogImage={cardImageUrl}
>
	<script type="application/ld+json" set:html={structuredData} />
	<div class="article-shell article-page">
		<Breadcrumbs items={[{ label: data.title }]} />
		<header class="article-header">
			<p class="eyebrow">{stage.title} · {domain.title}</p>
			<h1>{data.title}</h1>
			<div class="article-meta">
				<span>By {SITE.author}</span>
				<span>Published <time datetime={data.publishedAt.toISOString()}>{formatDate(data.publishedAt)}</time></span>
				<span>Updated <time datetime={data.updatedAt.toISOString()}>{formatDate(data.updatedAt)}</time></span>
				<span>{readingMinutes} min read</span>
			</div>
		</header>

		{heroImageModule ? (
			<Image
				class="article-hero"
				src={heroImageModule.default}
				alt={data.heroAlt ?? defaultHeroAlt}
				width={1200}
				height={675}
				format={heroImageFormat}
				quality={82}
				loading="eager"
				fetchpriority="high"
			/>
		) : (
			<img
				class="article-hero article-hero--fallback"
				src={defaultHeroImage}
				alt={defaultHeroAlt}
				width="1200"
				height="630"
				loading="eager"
				fetchpriority="high"
			/>
		)}

		<div class="disclosure">
			<strong>Disclosure:</strong> This page may contain affiliate links. If you use one,
			we may earn a commission at no extra cost to you.
		</div>

		<section class="quick-answer" aria-labelledby="quick-answer-heading">
			<h2 id="quick-answer-heading">Quick Answer</h2>
			<p>{data.description}</p>
		</section>

		<nav class="toc" aria-label="On this page">
			<a href="#guide">Guide</a>
			<a href="#measured">Measured data</a>
			<a href="#youll-be-asked">You'll be asked</a>
			<a href="#say-this">Say this</a>
			<a href="#show-cards">Phrase cards</a>
			{data.faq.length > 0 && <a href="#faq">FAQ</a>}
		</nav>

		<AdSlot position="top" />

		<article id="guide" class="article-body">
			<Content />
		</article>

		<section id="measured" aria-labelledby="measured-heading">
			<h2 id="measured-heading">Measured in Tokyo</h2>
			<div class="table-container">
				<p class="table-scroll-hint">Scroll horizontally if needed to see the full table.</p>
				<div class="data-table-wrap" role="group" aria-label="Table (scroll horizontally if needed)" tabindex="0">
					<table class="data-table">
						<thead>
							<tr>
								<th scope="col">Item</th>
								<th scope="col">Price</th>
								<th scope="col">Place and notes</th>
							</tr>
						</thead>
						<tbody>
							{data.measured.map((row) => (
								<tr>
									<td>{row.item}</td>
									<td class="price-cell">
										{formatJpy(row.priceJpy)}
										<small>{formatUsd(row.priceJpy, SITE.currency.usdJpyRate)}</small>
									</td>
									<td>
										<strong>{row.place}</strong>
										<br />
										{row.note}
									</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</div>
			<p class="exchange-note">
				USD conversions use ¥{SITE.currency.usdJpyRate} per US$1 (reference rate checked
				{` ${formatDate(new Date(`${SITE.currency.checkedAt}T00:00:00Z`))}`}); amounts are
				approximate. Prices marked as sample data are illustrative, not verified current prices.
			</p>
		</section>

		<AdSlot position="middle" />

		<section id="youll-be-asked" class="phrase-section" aria-labelledby="asked-heading">
			<p class="eyebrow">Listen for these</p>
			<h2 id="asked-heading">You'll be asked</h2>
			<div class="phrase-list">
				{data.phrasesAsked.map((phrase) => (
					<div class="phrase-card">
						<p class="phrase-card__jp" lang="ja">{phrase.jp}</p>
						<p class="phrase-card__romaji">{phrase.romaji}</p>
						<p class="phrase-card__en">{phrase.en}</p>
						<div class="answer-list" aria-label="Possible answers">
							{phrase.answers.map((answer) => (
								<div class="answer-option">
									<strong lang="ja">{answer.jp}</strong>
									<span>{answer.romaji}</span>
									<span>— {answer.en}</span>
								</div>
							))}
						</div>
					</div>
				))}
			</div>
		</section>

		<section id="say-this" class="phrase-section" aria-labelledby="say-heading">
			<p class="eyebrow">Show or say this</p>
			<h2 id="say-heading">Say this / Show this</h2>
			<div class="phrase-list">
				{data.phrasesSay.map((phrase, index) => (
					<div id={getSayPhraseId(index)} class="phrase-card say-card">
						<p class="phrase-card__jp" lang="ja">{phrase.jp}</p>
						<p class="phrase-card__romaji">{phrase.romaji}</p>
						<p class="phrase-card__en">{phrase.en}</p>
						<p class="say-card__situation">{phrase.situation}</p>
					</div>
				))}
			</div>
		</section>

		<section id="show-cards" class="show-cards" aria-labelledby="cards-heading">
			<p class="eyebrow">Works offline</p>
			<h2 id="cards-heading">Phrase cards to show</h2>
			<div class="show-card-grid">
				{data.phrasesSay.map((phrase, index) => {
					const imageUrl = `/cards/${data.slug}/${index + 1}.svg`;
					return (
						<div class="show-card">
							<div class="show-card__content">
								<p class="phrase-card__jp" lang="ja">{phrase.jp}</p>
								<p class="phrase-card__romaji">{phrase.romaji}</p>
								<p>{phrase.en}</p>
							</div>
							<img src={imageUrl} alt={`Phrase card: ${phrase.jp} — ${phrase.en}`} width="1200" height="630" loading="lazy" />
							<div class="show-card__content">
								<a href={imageUrl} download={`${data.slug}-phrase-${index + 1}.svg`} data-card-save>
									Save phrase card
								</a>
							</div>
						</div>
					);
				})}
			</div>
		</section>

		{
			affiliateItems.length > 0 && (
				<section aria-labelledby="affiliate-heading">
					<h2 id="affiliate-heading">Useful links</h2>
					<ul class="affiliate-list">
						{affiliateItems.map((link) => (
							<li>
								<a href={`/go/${link.id}/`} data-affiliate-id={link.id} rel="sponsored">
									{link.label}
								</a>
							</li>
						))}
					</ul>
				</section>
			)
		}

		{
			data.faq.length > 0 && (
				<section id="faq" class="faq-list" aria-labelledby="faq-heading">
					<h2 id="faq-heading">Frequently asked questions</h2>
					{data.faq.map((item) => (
						<details>
							<summary>{item.question}</summary>
							<p>{item.answer}</p>
						</details>
					))}
				</section>
			)
		}

		<div class="author-box">
			<div class="author-box__mark" aria-hidden="true">O</div>
			<div>
				<strong>{SITE.author}</strong>
				<p>Ordinary Tokyo focuses on everyday places, local checks, and practical details for visitors.</p>
			</div>
		</div>

		<p class="small-note">
			Checked on {formatDate(data.checkedAt)} · Last updated {formatDate(data.updatedAt)}.
			Prices and services can change; confirm details at the store.
		</p>

		<AdSlot position="bottom" />

		{
			related.length > 0 && (
				<section class="related" aria-labelledby="related-heading">
					<div class="section-heading">
						<div>
							<p class="eyebrow">Keep exploring</p>
							<h2 id="related-heading">Related guides</h2>
						</div>
					</div>
					<ArticleList articles={related} />
				</section>
			)
		}
	</div>
	<a class="mobile-card-cta" href="#show-cards">Save a phrase card</a>
	<script>
		const tableContainers = document.querySelectorAll('.table-container');
		function updateTableScrollHints() {
			for (const container of tableContainers) {
				const wrapper = container.querySelector('.data-table-wrap');
				const hint = container.querySelector('.table-scroll-hint');
				if (!(wrapper instanceof HTMLElement) || !(hint instanceof HTMLElement)) continue;
				const scrollable = wrapper.scrollWidth > wrapper.clientWidth;
				hint.hidden = !scrollable;
				if (scrollable) wrapper.tabIndex = 0;
				else wrapper.removeAttribute('tabindex');
			}
		}
		updateTableScrollHints();
		if (typeof ResizeObserver !== 'undefined') {
			const tableObserver = new ResizeObserver(updateTableScrollHints);
			for (const container of tableContainers) {
				const wrapper = container.querySelector('.data-table-wrap');
				const table = wrapper?.querySelector('table');
				if (wrapper) tableObserver.observe(wrapper);
				if (table) tableObserver.observe(table);
			}
		} else {
			window.addEventListener('resize', updateTableScrollHints);
			document.fonts?.ready.then(updateTableScrollHints);
		}

		const mobileCardCta = document.querySelector('.mobile-card-cta');
		const articleHero = document.querySelector('.article-hero');
		const phraseCards = document.querySelector('#show-cards');
		if (mobileCardCta instanceof HTMLAnchorElement && articleHero && phraseCards) {
			mobileCardCta.classList.add('is-enhanced');
			if ('IntersectionObserver' in window) {
				let heroVisible = false;
				let phraseCardsVisible = false;
				const observer = new IntersectionObserver((entries) => {
					for (const entry of entries) {
						if (entry.target === articleHero) heroVisible = entry.isIntersecting;
						if (entry.target === phraseCards) phraseCardsVisible = entry.isIntersecting;
					}
					mobileCardCta.classList.toggle(
						'is-visible',
						!heroVisible && !phraseCardsVisible,
					);
				});
				observer.observe(articleHero);
				observer.observe(phraseCards);
			} else {
				mobileCardCta.classList.add('is-visible');
			}
		}
	</script>
</SiteLayout>
